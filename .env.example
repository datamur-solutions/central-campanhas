# Copie para .env e preencha. Nunca versione o .env.

# Motor de dados: postgres ou databricks
DB_ENGINE=postgres

# Postgres / Supabase
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
POSTGRES_SCHEMA=public
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=5

# Databricks SQL
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_CATALOG=lakehouse
DATABRICKS_SCHEMA=comercial
DATABRICKS_TOKEN=
DATABRICKS_CONFIG_PROFILE=

# Sessao e seguranca
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
SESSION_HORAS=12
COOKIE_SECURE=true
DOCS_HABILITADO=false
HOMOLOG_USER=
HOMOLOG_PASS=

# E-mail (Brevo)
APP_BASE_URL=http://localhost:8000
BREVO_API_KEY=
EMAIL_REMETENTE=central@edunova.com.br
EMAIL_REMETENTE_NOME=Central de Campanhas
EMAIL_DOMINIO_INTERNO=edunova.com.br

# Integracoes
CAMPAIGN_HTML_WEBHOOK_URL=
ROBO_API_KEY=troque-por-uma-chave-aleatoria
ROBO_ALERTA_EMAILS=planejamento@edunova.com.br

# Robo de apuracao (app/robo_vm)
CENTRAL=http://localhost:8000
DBX_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DBX_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
VOLUME=/Volumes/lakehouse/comercial/arquivos
SCHEMA_CENTRAL=lakehouse.comercial
TAB_MAILING=lakehouse.comercial.tb_mailing_campanha
TAB_APURACAO=lakehouse.comercial.tb_apuracao_campanha
TAB_DETALHE=lakehouse.comercial.tb_apuracao_campanha_detalhe
